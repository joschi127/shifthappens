# Vite
manifest.json
browserconfig.xml

# Backup files (test data)
/backup_files
/.aider*
!/.aider.conf.yml
!/.aider.conventions.md

# temp/: kurzlebige Arbeitsdateien (z. B. gerade übergebene Bilder), dürfen jederzeit gelöscht werden.
# Nur .gitkeep wird eingecheckt, damit der Ordner existiert.
/temp/*
!/temp/.gitkeep

# Dateien für die Texterkennung, werden vor dev/build aus node_modules kopiert (scripts/copy-tesseract-assets.mjs)
/public/tesseract/

# Sprachdaten, die tesseract.js bei Simulationsläufen (scripts/poc-local-recognition/) im Arbeitsverzeichnis zwischenspeichert
*.traineddata

# local/: dauerhaft aufzubewahrende, aber private Daten (z. B. echte Dienstpläne als Testdaten).
# Werden wiederholt genutzt, dürfen aber nie ins Git. Nur .gitkeep wird eingecheckt.
/local/*
!/local/.gitkeep
